// ZVIDEO (zstudio) — Prisma schema
// Project > Character / Tap > Scene > Shot > ShotContent / Frame; Comment polymorphic

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CommentTarget {
  CHARACTER
  TAP
  SCENE
  SHOT
}

enum ShotContentType {
  HANHDONG
  THOAI
  AMTHANH
  ANHSANG
}

// MANAGER: full quyền (nội dung + tài khoản user + gán quyền module). Duy
// nhất 1 người, không thể gán role này cho ai khác qua ứng dụng, và tài
// khoản Manager không thể bị sửa/ẩn/xóa qua các API quản lý user.
// ASSISTANT: quản lý tài khoản user (duyệt đăng ký, đổi tên, reset mật
// khẩu, ẩn/xóa, đổi role Assistant/Admin/Staff) — KHÔNG có quyền trên
// nội dung project, KHÔNG gán quyền module cho Staff.
// ADMIN: full quyền nội dung project (Project/Tập/Cảnh/Shot...) và là
// người gán quyền module cho từng Staff — KHÔNG quản lý tài khoản user.
// STAFF: quyền theo từng module trong `permissions` (do Manager/Admin gán),
// chỉ sửa được nội dung do chính mình tạo.
enum Role {
  MANAGER
  ASSISTANT
  ADMIN
  STAFF
}

model User {
  id          Int      @id @default(autoincrement())
  username    String   @unique
  password    String
  name        String
  role        Role     @default(STAFF)
  permissions String[] @default([])
  active      Boolean  @default(true)
  // Tài khoản tự đăng ký (Admin/Staff) chờ Manager duyệt mới đăng nhập được.
  approved    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Project {
  id            Int         @id @default(autoincrement())
  title         String
  mainPlot      String      @default("") @map("main_plot")
  createdAt     DateTime    @default(now()) @map("created_at")
  createdById   Int         @map("created_by_id")
  createdByName String      @map("created_by_name")
  characters    Character[]
  taps          Tap[]

  @@map("projects")
}

model Character {
  id            Int      @id @default(autoincrement())
  projectId     Int      @map("project_id")
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  desc          String   @default("")
  createdById   Int      @map("created_by_id")
  createdByName String   @map("created_by_name")
  active        Boolean  @default(true)

  @@index([projectId])
  @@map("characters")
}

model Tap {
  id            Int      @id @default(autoincrement())
  projectId     Int      @map("project_id")
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  summary       String   @default("")
  locations     String[] @default([])
  equipment     String[] @default([])
  costumes      String[] @default([])
  order         Int      @default(0)
  createdById   Int      @map("created_by_id")
  createdByName String   @map("created_by_name")
  active        Boolean  @default(true)
  scenes        Scene[]

  @@index([projectId])
  @@map("taps")
}

model Scene {
  id                Int      @id @default(autoincrement())
  tapId             Int      @map("tap_id")
  tap               Tap      @relation(fields: [tapId], references: [id], onDelete: Cascade)
  title             String
  space             String   @default("")
  time              String   @default("")
  charactersPresent String[] @default([]) @map("characters_present")
  order             Int      @default(0)
  createdById       Int      @map("created_by_id")
  createdByName     String   @map("created_by_name")
  active            Boolean  @default(true)
  shots             Shot[]

  @@index([tapId])
  @@map("scenes")
}

model Shot {
  id            Int           @id @default(autoincrement())
  sceneId       Int           @map("scene_id")
  scene         Scene         @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  title         String
  angle         String        @default("")
  movement      String        @default("")
  order         Int           @default(0)
  createdById   Int           @map("created_by_id")
  createdByName String        @map("created_by_name")
  active        Boolean       @default(true)
  contents      ShotContent[]
  frames        Frame[]

  @@index([sceneId])
  @@map("shots")
}

model ShotContent {
  id            Int             @id @default(autoincrement())
  shotId        Int             @map("shot_id")
  shot          Shot            @relation(fields: [shotId], references: [id], onDelete: Cascade)
  type          ShotContentType
  character     String          @default("")
  text          String          @default("")
  order         Int             @default(0)
  createdById   Int             @map("created_by_id")
  createdByName String          @map("created_by_name")
  active        Boolean         @default(true)

  @@index([shotId])
  @@map("shot_contents")
}

model Frame {
  id            Int      @id @default(autoincrement())
  shotId        Int      @map("shot_id")
  shot          Shot     @relation(fields: [shotId], references: [id], onDelete: Cascade)
  imageUrl      String   @map("image_url")
  order         Int      @default(0)
  createdById   Int      @map("created_by_id")
  createdByName String   @map("created_by_name")
  active        Boolean  @default(true)

  @@index([shotId])
  @@map("frames")
}

model Comment {
  id         Int           @id @default(autoincrement())
  targetType CommentTarget @map("target_type")
  targetId   Int           @map("target_id")
  author     String
  text       String
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([targetType, targetId])
  @@map("comments")
}
